// Fonte do diagrama de arquitetura + fluxo CI/CD (Sprint 4).
// Regerar: dot -Tpng -Gdpi=150 docs/azure/arquitetura-cicd.dot -o docs/azure/arquitetura-cicd.png
//          dot -Grankdir=TB -Tpng -Gdpi=150 docs/azure/arquitetura-cicd.dot -o docs/azure/arquitetura-cicd-vertical.png
digraph G {
  rankdir=LR; splines=spline; nodesep=0.45; ranksep=0.7; pad=0.3;
  graph [fontname="DejaVu Sans", fontsize=13, labelloc=t, label="Olli Pet API - Arquitetura e fluxo CI/CD (Sprint 4 - DevOps Tools & Cloud Computing - 2TDSA)\n\n"];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555", margin="0.18,0.10"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#555555"];

  dev [label="Desenvolvedor\n(equipe Olli Pet)", shape=ellipse, fillcolor="#fff2cc", color="#bf9000"];

  subgraph cluster_gh { label="GitHub"; style="rounded"; color="#333333";
    repo [label="Repositorio\nSprint4DevOps\n(branch main)", fillcolor="#eeeeee"];
  }

  subgraph cluster_ado { label="Azure DevOps - projeto \"Sprint 4 - Azure DevOps\""; style="rounded"; color="#0078d4"; fontcolor="#0078d4";
    ci   [label="CI - stage Build\nMaven@4: mvn clean package\n(compila + testes JUnit)", fillcolor="#dbe9f9"];
    tst  [label="Resultados dos testes\n(aba Tests do run)", fillcolor="#dbe9f9"];
    art  [label="Artefato \"drop\"\n(.jar da API)", fillcolor="#dbe9f9"];
    cd   [label="CD - stage Deploy\nAzureWebApp@1\n(dependsOn: Build)", fillcolor="#dbe9f9"];
    vg   [label="Variable Group\nollipet-cloud\n(credenciais secret)", shape=note, fillcolor="#fde9d9", color="#c0504d"];
  }

  subgraph cluster_az { label="Microsoft Azure - rg-ollipet-rm562917"; style="rounded"; color="#005a9e"; fontcolor="#005a9e";
    web [label="Azure Web App (Linux)\nollipet-api-rm562917\nJava 21 - Spring Boot\nperfil cloud", fillcolor="#cfe8fc"];
    db  [label="Azure Database for MySQL\nFlexible Server\nmysql-ollipet-rm562917\nschema ollipet", shape=cylinder, fillcolor="#cfe8fc"];
  }

  user [label="Usuario\n(Swagger / app mobile)", shape=ellipse, fillcolor="#fff2cc", color="#bf9000"];

  dev  -> repo [label="1. git push main"];
  repo -> ci   [label="2. trigger\nautomatico", color="#0078d4", fontcolor="#0078d4"];
  ci   -> tst  [label="3. publica", color="#0078d4", fontcolor="#0078d4"];
  ci   -> art  [label="4. publica", color="#0078d4", fontcolor="#0078d4"];
  art  -> cd   [label="5. dispara CD", color="#0078d4", fontcolor="#0078d4"];
  vg   -> cd   [label="credenciais", style=dashed, color="#c0504d", fontcolor="#c0504d"];
  cd   -> web  [label="6. deploy .jar\n+ App Settings", color="#005a9e", fontcolor="#005a9e"];
  web  -> db   [label="7. JDBC/SSL\nFlyway V1..V8", color="#005a9e", fontcolor="#005a9e"];
  user -> web  [label="HTTPS /api/v1/**", color="#bf9000", fontcolor="#bf9000"];
}
