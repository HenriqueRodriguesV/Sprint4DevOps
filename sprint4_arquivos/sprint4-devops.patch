--- /dev/null
+++ b/azure-pipelines.yml
@@ -0,0 +1,85 @@
+# Pipeline CI/CD - Sprint 4 (Azure DevOps)
+#
+# CI  (stage Build):  build com Maven + testes automaticos (xUnit/Surefire) +
+#                      publicacao do artefato (.jar) no Azure DevOps.
+# CD  (stage Deploy):  dispara automaticamente apos o artefato ser gerado,
+#                      faz o deploy no Azure Web App (Linux, Java 21).
+#
+# Dispara a cada push na branch principal do repositorio (Regra II do roteiro).
+# O repositorio java-ollipet usa "main" como branch padrao (nao "master") -
+# se o seu repo usar outro nome, ajuste aqui.
+trigger:
+  branches:
+    include:
+      - main
+
+pool:
+  vmImage: 'ubuntu-latest'
+
+# Variaveis sensiveis (usuario/senha do banco, nome do Web App) NAO ficam aqui:
+# vem do Variable Group "ollipet-cloud" criado no Azure DevOps > Pipelines >
+# Library, com as variaveis DATASOURCE_USERNAME, DATASOURCE_PASSWORD e
+# DATABASE_URL marcadas com o cadeado (secret) - Regra IV do roteiro.
+variables:
+  - group: ollipet-cloud
+
+stages:
+  # ---------------------------------------------------------------------
+  # CI - build + testes + publicacao do artefato
+  # ---------------------------------------------------------------------
+  - stage: Build
+    displayName: 'CI - Build e Testes'
+    jobs:
+      - job: BuildAndTest
+        displayName: 'Build com Maven e testes automaticos'
+        steps:
+          - task: Maven@4
+            displayName: 'mvn clean package (compila + roda os testes xUnit/JUnit)'
+            inputs:
+              mavenPomFile: 'pom.xml'
+              goals: 'clean package'
+              publishJUnitResults: true
+              testResultsFiles: '**/surefire-reports/TEST-*.xml'
+              javaHomeOption: 'JDKVersion'
+              jdkVersionOption: '1.21'
+              mavenVersionOption: 'Default'
+
+          - task: CopyFiles@2
+            displayName: 'Copiar o jar gerado'
+            inputs:
+              sourceFolder: '$(System.DefaultWorkingDirectory)/target'
+              contents: '*.jar'
+              targetFolder: '$(Build.ArtifactStagingDirectory)'
+
+          - task: PublishPipelineArtifact@1
+            displayName: 'Publicar artefato no Azure DevOps'
+            inputs:
+              targetPath: '$(Build.ArtifactStagingDirectory)'
+              artifact: 'drop'
+              publishLocation: 'pipeline'
+
+  # ---------------------------------------------------------------------
+  # CD - dispara automaticamente apos o artefato da stage Build existir.
+  # ---------------------------------------------------------------------
+  - stage: Deploy
+    displayName: 'CD - Deploy no Azure Web App'
+    dependsOn: Build
+    condition: succeeded()
+    jobs:
+      - deployment: DeployWebApp
+        displayName: 'Deploy no Azure Web App (Linux, Java 21)'
+        environment: 'producao-ollipet'
+        pool:
+          vmImage: 'ubuntu-latest'
+        strategy:
+          runOnce:
+            deploy:
+              steps:
+                - task: AzureWebApp@1
+                  displayName: 'Deploy do jar no Web App'
+                  inputs:
+                    azureSubscription: '$(azureServiceConnection)'
+                    appType: 'webAppLinux'
+                    appName: '$(webAppName)'
+                    package: '$(Pipeline.Workspace)/drop/*.jar'
+                    runtimeStack: 'JAVA|21-java21'
